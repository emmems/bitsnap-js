{
  "name": "bitsnap-js",
  "version": "1.2.1",
  "description": "This is Bitsnap Javascript Backend library for easy integration with any website which is using JS Backend framework",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test:contract": "pnpm build && node --test test/*.test.cjs",
    "build:publish": "pnpm build --env.publish",
    "clean": "rimraf ./dist",
    "dev": "tsup --watch",
    "dev:publish": "pnpm dev --env.publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmems/bitsnap-js.git"
  },
  "keywords": [
    "bitsnap",
    "bitsnap-js",
    "checkout",
    "shop",
    "ecommerce"
  ],
  "author": "Piotr Michalik",
  "license": "SEE LICENSE IN LICENSE file",
  "bugs": {
    "url": "https://github.com/emmems/bitsnap-js/issues"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/emmems/bitsnap-js#readme",
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.10.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "^3.4.15",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.0",
    "@connectrpc/connect": "^2.0.4",
    "@connectrpc/connect-node": "^2.0.4",
    "@connectrpc/connect-query": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.0",
    "tslib": "^2.8.1",
    "zod": "4.1.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./backend": {
      "types": "./dist/backend.d.ts",
      "import": "./dist/backend.mjs",
      "require": "./dist/backend.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "import": "./dist/models.mjs",
      "require": "./dist/models.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.mjs",
      "require": "./dist/internal.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.mjs",
      "require": "./dist/errors.js"
    },
    "./returns": {
      "types": "./dist/returns.d.ts",
      "import": "./dist/returns.mjs",
      "require": "./dist/returns.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "backend": [
        "./dist/backend.d.ts"
      ],
      "models": [
        "./dist/models.d.ts"
      ],
      "internal": [
        "./dist/internal.d.ts"
      ],
      "errors": [
        "./dist/errors.d.ts"
      ],
      "returns": [
        "./dist/returns.d.ts"
      ]
    }
  }
}
